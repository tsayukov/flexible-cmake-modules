# Lcov

Enable the [`<FCM_PROJECT_CACHE_PREFIX>ENABLE_COVERAGE`][201] option
to use [`lcov`][501] as a code coverage for UNIX systems. If `lcov` or `genhtml`
cannot be found, set `LCOV_PATH` or `GENHTML_PATH` to the path to the binary
file of `lcov` or `genhtml` accordingly.

## Table of Contents:

- [fcm_lcov_enable](#fcm_lcov_enable)
- [fcm_lcov_add_custom_target](#fcm_lcov_add_custom_target)

## fcm_lcov_enable

Enable code coverage compile and link options for a given target.

```
fcm_lcov_enable(<target>)
```

After [resolving][101] the `<target>` name, add to `<target>` the private
compile option `--coverage` and the public link option `--coverage`.

Each time the `<target>`'s sources have been compiled (but before linking
or running), it removes all `*.gcda` files in the binary directory.

It has no effect for interface libraries.

## fcm_lcov_add_custom_target

Add an `<FCM_PROJECT_TARGET_PREFIX><custom_target_suffix>` custom target that
runs all code coverage testing that were added by previous `fcm_lcov_enable()`
calls.

```
fcm_lcov_add_custom_target(<custom_target_suffix>
                           [GCOV_TOOL <gcov_tool_path>]
                           [OUTPUT_COVERAGE_DIR <output_coverage_dir>]
                           [OUTPUT_HTML_DIR <output_html_dir>]
                           [EXCLUDE <exclude_glob_patterns>...]
                           [INCLUDE <include_glob_patterns>...]
                           [PARALLEL <nproc>]
                           [BRANCH_COVERAGE] [FLAT_LAYOUT]
                           [LCOV_OPTIONS <lcov_options>...]
                           [GENHTML_OPTIONS <genhtml_options>...])
```

The custom targer causes the following calls:

```
lcov --gcov-tool <gcov_tool_path>
     --zerocounters
     --directory <PROJECT_SOURCE_DIR>

<build and run all enabled executable targets>...

lcov --gcov-tool <gcov_tool_path>
     --capture
     --no-external
     --directory <PROJECT_SOURCE_DIR>
     --output-file <output_coverage_dir>/coverage.info
     [--rc lcov_branch_coverage=1]
     [--parallel <nproc>]
     [--demangle-cpp]
     [--exclude '<exclude_glob_pattern>']...
     [--include '<include_glob_pattern>']...
     [<lcov_options>...]

genhtml <output_coverage_dir>/coverage.info
        --legend
        --output-directory <output_html_dir>
        [--branch_coverage]
        [--flat | --hierarchical]
        [--parallel <nproc>]
        --demangle-cpp
        [<genhtml_options>...]
```

Specify the location of the gcov tool after the `GCOV_TOOL` key. By default,
it is [`gcov`][502] for the GNU compiler and [`llvm-cov`][503] for the Clang
compiler.

Specify the location for output `.info` tracefiles generated by `lcov` after
the `OUTPUT_COVERAGE_DIR` key. If `<output_coverage_dir>` is a relative path,
it will be prepended with [`<PROJECT_BINARY_DIR>`][301]. By default,
it is `<PROJECT_BINARY_DIR>/<custom_target>_lcov_tracefiles`.

Specify the location for output files generated by `genhtml` after
the `OUTPUT_COVERAGE_DIR` key. If `<output_html_dir>` is a relative path,
it will be prepended with `<PROJECT_BINARY_DIR>`. By default,
it is `<PROJECT_BINARY_DIR>/<custom_target>_html`.

Specify glob patterns matching source files to exclude from code coverage after
the `EXCLUDE` key. The patterns must be specified to match the absolute path
of each source files.

Specify glob patterns matching source files to include to code coverage after
the `INCLUDE` key. The patterns must be specified to match the absolute path
of each source files.

Set the `BRANCH_COVERAGE` option to enable the branch coverage.

For lcov 2+, specify parallelism to use during processing after the `PARALLEL`
key. See the `--parallel | -j` lcov/genhtml options for details. It will be applied to both
`lcov` and `genhtml`.

For lcov 2+, set the `FLAT_LAYOUT` option to set a flat HTML report hierarchy
layout. By default, it is hierarchical. See the `--flat | --hierarchical`
genhtml options for details.

Specify other lcov and genhtml options after the `LCOV_OPTIONS`
and `GENHTML_OPTIONS` accordingly.

[101]: https://github.com/tsayukov/flexible-cmake-modules/wiki/Project-targets#fcm_get_target

[201]: https://github.com/tsayukov/flexible-cmake-modules/wiki/Variables#ENABLE_COVERAGE

[301]: https://cmake.org/cmake/help/latest/variable/PROJECT_BINARY_DIR.html

[501]: https://github.com/linux-test-project/lcov
[502]: https://gcc.gnu.org/onlinedocs/gcc/Gcov.html
[503]: https://llvm.org/docs/CommandGuide/llvm-cov.html

#]=================================================================]#github/wiki

include_guard(GLOBAL)
@FCM_COMMAND_PREFIX@internal_variable_init_guard()


function(@FCM_COMMAND_PREFIX@lcov_enable
  target
)
  @FCM_COMMAND_PREFIX@enable_if(ENABLE_COVERAGE UNIX)

  @FCM_COMMAND_PREFIX@get_target(${target} FULL_NAME_TO target)
  get_target_property(type ${target} TYPE)
  if (type STREQUAL "INTERFACE_LIBRARY")
    message(AUTHOR_WARNING
      "Enabling lcov coverage for an interface library has no effect."
    )
    return()
  endif()

  target_compile_options(${target} PRIVATE --coverage)
  target_link_options(${target} PUBLIC --coverage)

  add_custom_command(TARGET ${target} PRE_LINK
    COMMAND find ${PROJECT_BINARY_DIR} -type f -name '*.gcda' -exec rm {} +
  )

  @FCM_COMMAND_PREFIX@get_project_cache_prefix()
  if (type STREQUAL "EXECUTABLE")
    set_property(DIRECTORY
        "${PROJECT_SOURCE_DIR}"
      APPEND PROPERTY
        ${FCM_PROJECT_CACHE_PREFIX}COVERAGE_EXECUTABLE_TARGETS ${target}
    )
  endif()
endfunction()

function(@FCM_COMMAND_PREFIX@lcov_add_custom_target
  custom_target_suffix
)
  @FCM_COMMAND_PREFIX@enable_if(ENABLE_COVERAGE UNIX)

  cmake_parse_arguments(PARSE_ARGV 1 "ARGS"
    "BRANCH_COVERAGE;FLAT_LAYOUT"
    "OUTPUT_COVERAGE_DIR;OUTPUT_HTML_DIR;GCOV_TOOL;PARALLEL"
    "EXCLUDE;INCLUDE;LCOV_OPTIONS;GENHTML_OPTIONS"
  )

  set(preparation_commands "")
  set(lcov_options "")
  set(genhtml_options "")

  @FCM_COMMAND_PREFIX@get_project_target_prefix()
  set(custom_target ${FCM_PROJECT_TARGET_PREFIX}${custom_target_suffix})

  if (NOT DEFINED ARGS_OUTPUT_COVERAGE_DIR)
    set(ARGS_OUTPUT_COVERAGE_DIR "${PROJECT_BINARY_DIR}/${custom_target}_lcov_tracefiles")
  elseif (NOT IS_ABSOLUTE "${ARGS_OUTPUT_COVERAGE_DIR}")
    set(ARGS_OUTPUT_COVERAGE_DIR "${PROJECT_BINARY_DIR}/${ARGS_OUTPUT_COVERAGE_DIR}")
  endif()
  file(MAKE_DIRECTORY "${ARGS_OUTPUT_COVERAGE_DIR}")

  if (NOT DEFINED ARGS_OUTPUT_HTML_DIR)
    set(ARGS_OUTPUT_HTML_DIR "${PROJECT_BINARY_DIR}/${custom_target}_html")
  elseif (NOT IS_ABSOLUTE "${ARGS_OUTPUT_HTML_DIR}")
    set(ARGS_OUTPUT_HTML_DIR "${PROJECT_BINARY_DIR}/${ARGS_OUTPUT_HTML_DIR}")
  endif()

  if (NOT DEFINED ARGS_GCOV_TOOL)
    if (CMAKE_C_COMPILER_ID STREQUAL "GNU" OR CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
      find_program(GCOV_PATH gcov REQUIRED)
      mark_as_advanced(GCOV_PATH)
      set(ARGS_GCOV_TOOL ${GCOV_PATH})
    elseif (CMAKE_C_COMPILER_ID STREQUAL "Clang" OR CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
      find_program(LLVM_COV_PATH llvm-cov REQUIRED)
      mark_as_advanced(LLVM_COV_PATH)

      set(gcov_llvm_wrapper_path "${ARGS_OUTPUT_COVERAGE_DIR}/gcov-llvm-wrapper.sh")

      if ("${CMAKE_CURRENT_FUNCTION_LIST_FILE}" IS_NEWER_THAN "${gcov_llvm_wrapper_path}")
        file(WRITE "${gcov_llvm_wrapper_path}" "exec ${LLVM_COV_PATH} gcov \"\$@\"")
      endif()

      list(APPEND preparation_commands
        COMMAND chmod u+x "${gcov_llvm_wrapper_path}"
      )

      set(ARGS_GCOV_TOOL "${gcov_llvm_wrapper_path}")
    else()
      message(FATAL_ERROR ${__FCM_DEBUG_CATCH_FATAL_ERROR__}
        "Neither GCC nor Clang compiler is used. "
        "Pass the specific GCOV_TOOL to `${CMAKE_CURRENT_FUNCTION}`."
      )
    endif()
  endif()

  set(LCOV_PATH ${LCOV_PATH} --gcov-tool ${ARGS_GCOV_TOOL})

  if (ARGS_BRANCH_COVERAGE)
    list(APPEND lcov_options --rc lcov_branch_coverage=1)
    list(APPEND genhtml_options --branch-coverage)
  endif()

  @FCM_COMMAND_PREFIX@get_version(lcov_version ${LCOV_PATH})
  if (lcov_version VERSION_GREATER_EQUAL "2")
    if (ARGS_FLAT_LAYOUT)
      list(APPEND genhtml_options --flat)
    else()
      list(APPEND genhtml_options --hierarchical)
    endif()

    if (DEFINED ARGS_PARALLEL)
      list(APPEND lcov_options --parallel ${ARGS_PARALLEL})
      list(APPEND genhtml_options --parallel ${ARGS_PARALLEL})
    endif()

    list(APPEND lcov_options --demangle-cpp)
  endif()

  list(APPEND genhtml_options --demangle-cpp)

  set(exclude_options "")
  if (DEFINED ARGS_EXCLUDE)
    foreach (exclude_pattern IN LISTS ARGS_EXCLUDE)
      list(APPEND exclude_options --exclude "'${exclude_pattern}'")
    endforeach()
  endif()

  set(include_options "")
  if (DEFINED ARGS_INCLUDE)
    foreach (include_pattern IN LISTS ARGS_INCLUDE)
      list(APPEND include_options --exclude "'${include_pattern}'")
    endforeach()
  endif()

  @FCM_COMMAND_PREFIX@get_project_cache_prefix()
  get_property(coverage_executable_targets
    DIRECTORY "${PROJECT_SOURCE_DIR}"
    PROPERTY ${FCM_PROJECT_CACHE_PREFIX}COVERAGE_EXECUTABLE_TARGETS
  )
  if (NOT coverage_executable_targets)
    message(FATAL_ERROR ${__FCM_DEBUG_CATCH_FATAL_ERROR__}
      "There are no executable targets to build and run. "
      "Hint: call the `@FCM_COMMAND_PREFIX@lcov_enable(<target>)` for targets "
      "that should be covered; at least one of them must be executable."
    )
  endif()

  set(build_and_run_targets "")
  foreach (target IN LISTS coverage_executable_targets)
    list(APPEND build_and_run_targets "COMMAND" "\$<TARGET_FILE:${target}>")
  endforeach()

  add_custom_target(${custom_target}
    COMMENT "Running code coverage"
    ${preparation_commands}
    COMMAND ${LCOV_PATH}
      --zerocounters
      --directory ${PROJECT_SOURCE_DIR}
    ${build_and_run_targets}
    COMMAND ${LCOV_PATH}
      --capture
      --no-external
      --directory ${PROJECT_SOURCE_DIR}
      --output-file ${ARGS_OUTPUT_COVERAGE_DIR}/coverage.info
      ${exclude_options}
      ${include_options}
      ${lcov_options}
      ${ARGS_LCOV_OPTIONS}
    COMMAND ${GENHTML_PATH}
      ${ARGS_OUTPUT_COVERAGE_DIR}/coverage.info
      --legend
      --output-directory ${ARGS_OUTPUT_HTML_DIR}
      ${genhtml_options}
      ${ARGS_GENHTML_OPTIONS}
  )
endfunction()


################################## Lcov init ###################################

@FCM_COMMAND_PREFIX@enable_if(ENABLE_COVERAGE UNIX)

find_program(LCOV_PATH lcov REQUIRED)
mark_as_advanced(LCOV_PATH)

find_program(GENHTML_PATH genhtml REQUIRED)
mark_as_advanced(GENHTML_PATH)
